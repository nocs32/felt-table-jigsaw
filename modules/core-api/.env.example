# core-api environment. Copy to `.env` (same folder) and fill in; `.env` is loaded by src/config.ts
# and must never be committed. Real environment variables work too.

# Unsplash access key (https://unsplash.com/oauth/applications). Used only by the server, as
# `Authorization: Client-ID <key>` on requests to api.unsplash.com; it never reaches the browser.
# Leave empty to turn the Unsplash photo picker off (GET /api/unsplash/status answers enabled: false).
UNSPLASH_ACCESS_KEY=

# Unsplash secret key. Not used by core-api (no OAuth user login); listed only so it lives here, not in code.
UNSPLASH_SECRET_KEY=

# Optional: an Unsplash collection id for the "Featured" list.
# Empty = popular landscape photos from the Wallpapers topic.
UNSPLASH_COLLECTION_ID=

# Optional: HTTP port. Default 2567. Uncomment to change it (an empty value is rejected).
# CORE_API_PORT=2567
